APP_NAME="Ferosa Landscaping"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Philippine statutory discounts are fail-closed. Confirm these settings with
# Ferosa's accountant or BIR RDO before enabling them in production.
PH_DISCOUNTS_ENABLED=false
PH_DISCOUNT_STATUTORY_20_ENABLED=false
PH_DISCOUNT_BNPC_5_ENABLED=false
FEROSA_PROMOTIONAL_SENIOR_PWD_ENABLED=true
# BNPC stays unavailable until purchase-booklet, four-item-kind, and cross-channel weekly-spend checks exist.
# Leave blank until Ferosa's VAT registration status is confirmed.
BUSINESS_VAT_REGISTERED=
BUSINESS_PRICES_INCLUDE_VAT=true
BUSINESS_VAT_RATE_PERCENT=12
# Set true only if every checkout catalogue item is confirmed VATable.
BUSINESS_ALL_CHECKOUT_PRODUCTS_VATABLE=false
# Set true only after confirming every appointment service is VATable.
BUSINESS_ALL_SERVICES_VATABLE=false
PH_DISCOUNT_BNPC_WEEKLY_LIMIT=2500.00

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Send the session cookie over HTTPS only. Leave false for plain-HTTP LAN
# testing; set to true in production or the cookie - which is the whole login -
# travels in the clear and can be replayed by anyone on the same network.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ferosa.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Production checklist:
# APP_ENV=production
# APP_DEBUG=false          <- with this true, any 500 renders DB and API credentials
# APP_URL=https://your-ferosa-domain.example
# SESSION_SECURE_COOKIE=true
# Point the vhost DocumentRoot at ferosa-laravel/public. If the project is
#   instead served from inside htdocs, the ../.htaccess deny rules are the only
#   thing keeping .env, storage/ and vendor/ off the public web - verify with
#   `curl -o /dev/null -w '%{http_code}' https://your-host/ferosa-laravel/.env`
#   and expect 403.
# Set real database, mail, queue, cache, and SMS credentials.
# Run both `php artisan queue:work --queue=sms,default --sleep=1 --tries=3` and `php artisan schedule:work`.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# SMS notifications: log | twilio | textbee
SMS_DRIVER=log
TEXTBEE_DEVICE_ID=
TEXTBEE_API_KEY=
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
